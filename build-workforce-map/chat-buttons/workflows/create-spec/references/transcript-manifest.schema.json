{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/evidence-first-transcript-manifest.schema.json",
  "title": "Transcript Parse Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "parser_version", "input", "outputs", "metrics", "validation_status"],
  "properties": {
    "run_id": {"type": "string"},
    "parser_version": {"type": "string"},
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    },
    "outputs": {"type": "object", "additionalProperties": {"type": "string"}},
    "metrics": {"type": "object"},
    "validation_status": {"enum": ["pass", "pass_with_warnings", "fail"]}
  }
}
